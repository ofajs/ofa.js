{
  "name": "ofajs-monorepo",
  "private": true,
  "version": "5.0.0",
  "description": "ofa.js framework monorepo",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "playwright test",
    "test:drill": "playwright test packages/drill",
    "test:router": "playwright test packages/router",
    "test:scsr": "playwright test packages/scsr",
    "test:stanz": "playwright test packages/stanz",
    "test:ofajs": "playwright test packages/ofajs",
    "build": "rollup -c",
    "bench": "npm run bench:drill && npm run bench:stanz && npm run bench:xhear && npm run bench:ofajs",
    "bench:drill": "node packages/drill/benchmark/run.mjs",
    "bench:stanz": "node packages/stanz/benchmark/run.mjs",
    "bench:xhear": "node packages/xhear/benchmark/run.mjs",
    "server": "node scripts/static-server.mjs",
    "bench:ofajs": "node packages/ofajs/benchmark/run.mjs",
    "bench:cross": "node packages/ofajs/benchmark/run-cross.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.64.5"
  },
  "author": {
    "name": "YAO",
    "email": "kirayao@hotmail.com"
  },
  "license": "MIT",
  "startyear": "2018",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofajs/ofa.js.git"
  },
  "homepage": "https://github.com/ofajs/ofa.js"
}
